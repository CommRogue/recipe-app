rules_version = '2';

// Baseline rules for the layout in docs/firestore-data-model.md (ADR 0007).
// This file implements the ownership principle and the backend-only subtrees.
// The caps, the Recipe immutability rule, the saved-Recipe cap and the Profile
// bounds from the data model are implementation work (#25) and are not here
// yet; until they land, the owner may write any shape under their own prefix.
service cloud.firestore {
  match /databases/{database}/documents {

    // The one ownership check (H12). Every allow under users/{uid} goes
    // through it, so a second way to be allowed to read is one change.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.recipeCount == 0;
      allow update: if isOwner(uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // account deletion is a backend job

      match /profile/default {
        allow read, write: if isOwner(uid);
      }

      // Client-owned collections. Their own field rules come with #25.
      match /recipes/{recipeId} {
        allow read, write: if isOwner(uid);
      }
      match /collections/{collectionId} {
        allow read, write: if isOwner(uid);
      }
      match /cookingSessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      // Backend-only: Plan and Quota. Written by the Go service through the
      // Admin SDK, which bypasses rules; a missing plan document means Free.
      match /server/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Backend-only: Draft Chains and their Drafts. The owner may read them
      // (to recover a Draft) and delete them (to discard), nothing else.
      match /draftChains/{chainId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;

        match /drafts/{draftId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if false;
        }
      }
    }

    // Backend-only, no client access at all.
    match /reports/{reportId} {
      allow read, write: if false;
    }
    match /revenuecatEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
